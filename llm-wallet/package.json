{
  "name": "llm-wallet-mcp",
  "version": "1.4.0",
  "description": "Universal MCP server for x402 wallet and payment capabilities",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "llm-wallet-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "x402",
    "wallet",
    "ai-agents",
    "micropayments",
    "polygon",
    "ethereum"
  ],
  "author": "x402 Protocol",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "dotenv": "^16.5.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.1.2",
    "viem": "^2.26.2",
    "x402": "^0.6.6",
    "x402-fetch": "^0.6.6",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "prettier": "^3.5.2",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}